{
  "expo": {
    "name": "Mandy's",
    "slug": "mandys_bubble_tea_app",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mandysbubbleteaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "buildNumber": "24",
      "bundleIdentifier": "com.mandysbubbletea.app",
      "appleTeamId": "HV982TTRNP",
      "associatedDomains": [
        "applinks:mandybubbletea.com",
        "webcredentials:mandybubbletea.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.mandysbubbletea.app"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.mandysbubbletea.app"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.mandysbubbletea.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C43A10",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1E14",
          "dark": {
            "backgroundColor": "#2A1E14"
          },
          "android": {
            "image": "./assets/images/splash-icon-rounded.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#2A1E14",
            "dark": {
              "backgroundColor": "#2A1E14"
            }
          }
        }
      ],
      "expo-secure-store",
      "react-native-square-in-app-payments",
      "./plugins/embed-square-frameworks",
      "./plugins/preserve-extra-google-url-scheme",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.744591425203-g5oh2tirvk6nafjus77s2bl3mg3admbe"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos when reporting an order issue.",
          "cameraPermission": "Used to take a photo when reporting an order issue.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb32735f-027e-4a57-ae17-4c9bc01dc6bf"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bb32735f-027e-4a57-ae17-4c9bc01dc6bf",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "24"
  }
}
