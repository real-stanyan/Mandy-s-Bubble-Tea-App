# LOCAL DEV ONLY. Compiled builds (EAS build / Xcode Archive) and OTA updates
# take their EXPO_PUBLIC_* values from the EAS `production` environment, not
# from this file — see `eas env:list production`. Keep them in sync when adding
# a key: a var that exists only here will be undefined for real users.
#
# Two of these are additionally hard-guarded: lib/api.ts and lib/square-payment.ts
# ignore the env var unless __DEV__ is true, so a sandbox value in .env.local can
# never reach a distributed build (regression guard from the build-22 incident).

# Backend API base (Next.js). In dev, point at your local tunnel/lan
# address so the device can hit /api/me etc. (e.g. https://xxx.ngrok.app).
EXPO_PUBLIC_API_BASE_URL=https://mandybubbletea.com

# Supabase — same project as the web app. NOT __DEV__-guarded: lib/supabase.ts
# throws at startup if these are missing, so they must exist in EAS too.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Sign-In (Phase 3b) — Web client ID is what Supabase verifies
# against, iOS client ID is what the native SDK uses at runtime.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Dev-build-only variant; not needed in the EAS production environment.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_DEV=

# Shared secret for the site-access gate on mandybubbletea.com — lets the app
# through the Coming Soon / password wall. No __DEV__ fallback.
EXPO_PUBLIC_SITE_ACCESS_APP_KEY=

# Square in-app payments. Release builds ALWAYS use the hardcoded production
# credentials in lib/square-payment.ts; these only take effect under __DEV__,
# for sandbox testing. LOCATION_ID is Android-only (Google Pay init).
EXPO_PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-...
EXPO_PUBLIC_SQUARE_LOCATION_ID=

# Detox e2e only — base URL of the auth fixture server.
EXPO_PUBLIC_DETOX_FIXTURE_URL=
